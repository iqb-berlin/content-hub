# Build stage
FROM --platform=$BUILDPLATFORM node:22.23.1-alpine3.24@sha256:16e22a550f3863206a3f701448c45f7912c6896a62de43add43bb9c86130c3e2 AS builder
ARG APP_VERSION=0.0.0-dev
ARG APP_COMMIT=local
ARG APP_BUILT_AT=unknown
WORKDIR /app
COPY package*.json ./
RUN npm ci --legacy-peer-deps
COPY . .
RUN npm run build -- --configuration production
RUN printf '{"version":"%s","commit":"%s","builtAt":"%s"}\n' \
      "$APP_VERSION" "$APP_COMMIT" "$APP_BUILT_AT" \
      > /app/dist/frontend/browser/version.json

# Production stage — serve with nginx
FROM nginx:1.30.6-alpine3.24@sha256:0e52bd054126cdc040b1276c0af347aeb02a41b9cfe305d6094767ac30e97949
ARG APP_VERSION=0.0.0-dev
ARG APP_COMMIT=local
ARG APP_BUILT_AT=unknown
LABEL org.opencontainers.image.version=${APP_VERSION} \
      org.opencontainers.image.revision=${APP_COMMIT} \
      org.opencontainers.image.created=${APP_BUILT_AT} \
      org.opencontainers.image.source="https://github.com/iqb-berlin/content-hub"
# Require patched runtime libraries from Alpine for every target architecture,
# including the branches reported by the candidate image scan.
RUN apk add --no-cache \
      'libcrypto3>=3.5.8-r0' \
      'libssl3>=3.5.8-r0' \
      'libexpat>=2.8.4-r0' \
      'libuuid>=2.42.3-r1' \
      'brotli-libs>=1.2.1-r0' \
      'curl>=8.23.0-r0' \
      'libcurl>=8.23.0-r0' \
      'libx11>=1.8.14-r0' \
      'nginx>=1.30.6-r0' \
      'pcre2>=10.49-r0' \
      'tiff>=4.7.2-r0'
# Angular's application builder outputs browser assets under dist/<project>/browser.
COPY --from=builder /app/dist/frontend/browser /usr/share/nginx/html
COPY nginx.spa.conf /etc/nginx/conf.d/default.conf
EXPOSE 80
