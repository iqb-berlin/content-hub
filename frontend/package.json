{
  "name": "frontend",
  "version": "0.6.0",
  "license": "Apache-2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "e2e": "../scripts/run-browser-e2e.sh",
    "e2e:playwright": "playwright test",
    "benchmark:item-explorer": "../scripts/run-item-explorer-browser-benchmark.sh",
    "lint": "ng lint --max-warnings=0",
    "lint:fix": "ng lint --fix --max-warnings=0",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss}\"",
    "format": "prettier --write \"src/**/*.{ts,html,scss}\"",
    "test:cov": "vitest run --coverage"
  },
  "private": true,
  "packageManager": "npm@11.7.0",
  "dependencies": {
    "@angular/common": "^21.2.19",
    "@angular/compiler": "^21.2.19",
    "@angular/core": "^21.2.19",
    "@angular/forms": "^21.2.19",
    "@angular/platform-browser": "^21.2.19",
    "@angular/router": "^21.2.19",
    "@iqb/responses": "^5.1.0",
    "@iqbspecs/coding-scheme": "^3.4.1",
    "@iqbspecs/variable-info": "^1.3.0",
    "angular-oauth2-oidc": "^20.0.2",
    "dompurify": "^3.4.17",
    "marked": "^18.0.2",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zone.js": "~0.15.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.19",
    "@angular/cli": "^21.2.19",
    "@angular/compiler-cli": "^21.2.19",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.2",
    "angular-eslint": "21.3.1",
    "eslint": "^10.0.3",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~5.9.2",
    "typescript-eslint": "8.56.1",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@angular/build": {
      "piscina": "5.3.2"
    }
  }
}
